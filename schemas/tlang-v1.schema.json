{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RevelaCode T-Lang v1 Template",
  "type": "object",
  "required": ["id", "version", "domain", "intent", "inputs", "steps", "output", "tests", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,79}$"},
    "version": {"const": 1},
    "domain": {"type": "string", "minLength": 1, "maxLength": 160},
    "intent": {"type": "string", "minLength": 1, "maxLength": 160},
    "triggers": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "object", "maxProperties": 20, "additionalProperties": {"type": "object", "required": ["type"], "additionalProperties": false, "properties": {"type": {"enum": ["string", "number", "integer", "boolean", "array", "object"]}, "required": {"type": "boolean"}, "description": {"type": "string"}}}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["id", "op", "args"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "op": {"type": "string"}, "args": {"type": "object"}}}},
    "output": {},
    "tests": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "object", "required": ["inputs", "expected"], "additionalProperties": false, "properties": {"inputs": {"type": "object"}, "expected": {}}}},
    "provenance": {"type": "object", "required": ["kind", "source_label"], "properties": {"kind": {"enum": ["seed", "teacher", "derived", "local"]}, "source_label": {"type": "string", "minLength": 1}}},
    "submission": {"type": "object", "required": ["child_id", "created_at", "nonce", "signature"], "properties": {"child_id": {"type": "string"}, "created_at": {"type": "string"}, "nonce": {"type": "string"}, "signature": {"type": "string"}}}
  }
}
