{"version":"tlang/1","id":"math.add","domain":"math","task":"add two numbers","triggers":["add","sum","plus"],"inputs":{"a":"number","b":"number"},"steps":[{"op":"add","args":[{"input":"a"},{"input":"b"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"a":2,"b":3},5],"expect":[{"a":-4,"b":7},3]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"math.subtract","domain":"math","task":"subtract the second number from the first","triggers":["subtract","minus","difference"],"inputs":{"a":"number","b":"number"},"steps":[{"op":"subtract","args":[{"input":"a"},{"input":"b"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"a":9,"b":4},5],"expect":[{"a":4,"b":9},-5]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"math.multiply","domain":"math","task":"multiply two numbers","triggers":["multiply","product","times"],"inputs":{"a":"number","b":"number"},"steps":[{"op":"multiply","args":[{"input":"a"},{"input":"b"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"a":6,"b":7},42],"expect":[{"a":-3,"b":2},-6]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"math.divide","domain":"math","task":"divide the first number by the second","triggers":["divide","quotient","ratio"],"inputs":{"a":"number","b":"number"},"steps":[{"op":"divide","args":[{"input":"a"},{"input":"b"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"a":20,"b":4},5],"expect":[{"a":9,"b":2},4.5]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"math.percentage_of","domain":"math","task":"calculate a percentage of a value","triggers":["percentage of","percent of","percentage"],"inputs":{"percent":"number","value":"number"},"steps":[{"op":"percentage_of","args":[{"input":"percent"},{"input":"value"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"percent":15,"value":200},30],"expect":[{"percent":7.5,"value":80},6]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"math.percentage_change","domain":"math","task":"calculate percentage change from an old value to a new value","triggers":["percentage change","percent change","growth rate"],"inputs":{"old_value":"number","new_value":"number"},"steps":[{"op":"percentage_change","args":[{"input":"old_value"},{"input":"new_value"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"old_value":100,"new_value":125},25],"expect":[{"old_value":200,"new_value":150},-25]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.average","domain":"statistics","task":"calculate the arithmetic mean of a number list","triggers":["average","mean"],"inputs":{"values":"number_list"},"steps":[{"op":"average","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[2,4,6]},4],"expect":[{"values":[10,20]},15]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.minimum","domain":"statistics","task":"find the smallest number in a list","triggers":["minimum","smallest","lowest"],"inputs":{"values":"number_list"},"steps":[{"op":"minimum","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[8,3,5]},3],"expect":[{"values":[-2,10,0]},-2]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.maximum","domain":"statistics","task":"find the largest number in a list","triggers":["maximum","largest","highest"],"inputs":{"values":"number_list"},"steps":[{"op":"maximum","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[8,3,5]},8],"expect":[{"values":[-2,10,0]},10]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.sort_ascending","domain":"statistics","task":"sort numeric values in ascending order","triggers":["sort ascending","ascending order","sort numbers"],"inputs":{"values":"number_list"},"steps":[{"op":"sort_ascending","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[3,1,2]},[1,2,3]],"expect":[{"values":[-1,8,0]},[-1,0,8]]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.sort_descending","domain":"statistics","task":"sort numeric values in descending order","triggers":["sort descending","descending order","reverse sort"],"inputs":{"values":"number_list"},"steps":[{"op":"sort_descending","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[3,1,2]},[3,2,1]],"expect":[{"values":[-1,8,0]},[8,0,-1]]},{}],"provenance":{"kind":"seed"}}
{"version":"tlang/1","id":"stats.unique","domain":"statistics","task":"remove duplicate values while preserving first occurrence","triggers":["unique values","remove duplicates","deduplicate"],"inputs":{"values":"number_list"},"steps":[{"op":"unique","args":[{"input":"values"}],"as":"result"}],"result":{"step":"result"},"tests":[{"input":[{"values":[2,2,1,2,3]},[2,1,3]],"expect":[{"values":[4,4,4]},[4]]},{}],"provenance":{"kind":"seed"}}
